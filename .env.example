# copy to .env and fill in. never commit .env
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_MODEL=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=dyepack

# alert routes. a channel left blank is simulated
# phone push: run python3 -m dyepack.notify topic, paste the name here and subscribe to it in the ntfy app
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=
# real sms needs all four (a twilio trial only texts verified numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=

# burst: a password only you know. it unlocks the real files sealed in the vault after a burst
DYEPACK_VAULT_PASSWORD=

# copy to .env and fill in. never commit .env
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_MODEL=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=dyepack

# alert routes. a channel left blank is simulated
# phone push: run python3 -m dyepack.notify topic, paste the name here and subscribe to it in the ntfy app
NTFY_TOPIC=
DISCORD_WEBHOOK_URL=
# real sms needs all four (a twilio trial only texts verified numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=

# lock in place: a password only you know. a decoy hit locks the customer files as .dye files with it
# and dyepack unlock opens them again. it also locks the drive's nightly backup.
# the old name DYEPACK_VAULT_PASSWORD still works
DYEPACK_LOCK_PASSWORD=
